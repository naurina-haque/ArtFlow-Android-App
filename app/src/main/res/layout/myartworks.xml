<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/purple_primary">

    <!-- Main Content Area with Toolbar -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Toolbar/Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@color/purple_dark"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="My ArtWorks"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/add_artwork_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ ADD ArtWork"
                    android:backgroundTint="@color/white"
                    android:textColor="@color/purple_primary"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <!-- Main Content Area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@color/white">

                <!-- Search Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/gray_light"
                    android:layout_marginBottom="16dp"
                    android:padding="8dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_launcher_foreground"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp" />

                    <EditText
                        android:id="@+id/search_bar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Search by category, artist name, artwork title..."
                        android:background="@android:color/transparent"
                        android:padding="8dp"
                        android:maxLines="1" />

                </LinearLayout>

                <!-- Category Chips Horizontal Scroll -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_all"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="All"
                            android:background="@drawable/chip_background_selected"
                            android:textColor="@color/white"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/chip_colored_portraits"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Colored Portraits"
                            android:background="@drawable/chip_background"
                            android:textColor="@color/purple_primary"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/chip_bw_portraits"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="B&amp;W Portraits"
                            android:background="@drawable/chip_background"
                            android:textColor="@color/purple_primary"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/chip_watercolor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Watercolor Art"
                            android:background="@drawable/chip_background"
                            android:textColor="@color/purple_primary"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/chip_digital"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Digital Art"
                            android:background="@drawable/chip_background"
                            android:textColor="@color/purple_primary"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/chip_abstract"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Abstract Art"
                            android:background="@drawable/chip_background"
                            android:textColor="@color/purple_primary"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/chip_landscape"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Landscape Art"
                            android:background="@drawable/chip_background"
                            android:textColor="@color/purple_primary"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/chip_line"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Line Art"
                            android:background="@drawable/chip_background"
                            android:textColor="@color/purple_primary"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center" />

                        <TextView
                            android:id="@+id/chip_acrylic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Acrylic Art"
                            android:background="@drawable/chip_background"
                            android:textColor="@color/purple_primary"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:layout_marginEnd="8dp"
                            android:gravity="center" />

                    </LinearLayout>

                </HorizontalScrollView>

                <!-- Artworks RecyclerView -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/artworks_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Navigation Sidebar -->
    <LinearLayout
        android:id="@+id/side_navigation"
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/purple_dark"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Menu"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="20dp"
            android:gravity="center" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/purple_light"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/dashboard_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dashboard"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:padding="12dp"
            android:drawableLeft="@drawable/ic_launcher_foreground"
            android:drawablePadding="10dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/myartworks_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="My Artworks"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:padding="12dp"
            android:drawableLeft="@drawable/ic_launcher_foreground"
            android:drawablePadding="10dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/orders_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Orders"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:padding="12dp"
            android:drawableLeft="@drawable/ic_launcher_foreground"
            android:drawablePadding="10dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/profile_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:padding="12dp"
            android:drawableLeft="@drawable/ic_launcher_foreground"
            android:drawablePadding="10dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/logout_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Logout"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:padding="12dp"
            android:drawableLeft="@drawable/ic_launcher_foreground"
            android:drawablePadding="10dp"
            android:layout_marginTop="40dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>