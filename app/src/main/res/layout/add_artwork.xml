<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/purple_light"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_new_artwork"
            android:textColor="@color/purple_primary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Image Upload Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/upload_artwork_image"
                android:textColor="@color/purple_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:background="@color/gray_light">

                <ImageView
                    android:id="@+id/artwork_image_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_launcher_foreground"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/image_upload_area"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@color/gray_light">

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/ic_launcher_foreground"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="@string/tap_to_upload_image" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tap_to_upload_image"
                        android:textColor="#666666"
                        android:textSize="14sp" />
                </LinearLayout>

            </FrameLayout>

            <Button
                android:id="@+id/btn_select_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/select_image"
                android:backgroundTint="@color/purple_primary"
                android:textColor="@color/white" />

        </LinearLayout>

        <!-- Artwork Title -->
        <EditText
            android:id="@+id/et_artwork_title"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:hint="@string/artwork_title"
            android:padding="16dp"
            android:textColor="@color/black"
            android:textColorHint="@color/gray_dark"
            android:inputType="textPersonName"
            android:background="@drawable/chip_background" />

        <!-- Artwork Description -->
        <EditText
            android:id="@+id/et_artwork_description"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="16dp"
            android:hint="@string/description"
            android:padding="16dp"
            android:textColor="@color/black"
            android:textColorHint="@color/gray_dark"
            android:inputType="textMultiLine"
            android:lines="3"
            android:maxLines="5"
            android:gravity="top|start"
            android:background="@drawable/chip_background" />

        <!-- Category Selection - Using Spinner as combobox -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/chip_background"
            android:padding="16dp"
            android:clipToPadding="false">

            <Spinner
                android:id="@+id/spinner_artwork_category"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/artwork_categories" />
        </LinearLayout>

        <!-- Price -->
        <EditText
            android:id="@+id/et_artwork_price"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="16dp"
            android:hint="@string/price_tk"
            android:inputType="numberDecimal"
            android:padding="16dp"
            android:textColor="@color/black"
            android:textColorHint="@color/gray_dark"
            android:background="@drawable/chip_background" />

        <!-- Publish Button -->
        <Button
            android:id="@+id/btn_publish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/publish_artwork"
            android:backgroundTint="@color/purple_primary"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:padding="16dp"
            android:layout_marginTop="16dp" />

    </LinearLayout>

</ScrollView>